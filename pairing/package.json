{
  "name": "@rieul/pairing-native",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/package.mjs",
    "check": "cargo check --manifest-path ../daemon/gui/Cargo.toml --features qa --locked",
    "test": "cargo test --manifest-path ../daemon/gui/Cargo.toml --lib --locked && node --test tests/*.test.mjs",
    "qa:native": "node scripts/native-qa.mjs"
  }
}
