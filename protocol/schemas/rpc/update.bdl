# standard - rieul-rpc
# description - Shared updater state and errors for remote and authenticated local control.

enum UpdatePhase {
  @ id - 0
  Unavailable,
  @ id - 1
  Idle,
  @ id - 2
  Checking,
  @ id - 3
  Downloading,
  @ id - 4
  Verifying,
  @ id - 5
  Ready,
  @ id - 6
  Deferred,
  @ id - 7
  Installing,
  @ id - 8
  Restarting,
  @ id - 9
  Failed,
}
struct UpdateStatus {
  @ id - 1
  phase: UpdatePhase,
  @ id - 2
  currentVersion?: string,
  @ id - 3
  targetVersion?: string,
  @ id - 4
  reason?: string,
  @ id - 5
  canInstall: bool,
  @ id - 6
  ordering: UpdateStatusOrdering,
}

struct UpdateStatusOrdering {
  @ id - 1
  epoch: string,
  @ id - 2
  revision: u53,
}
union UpdateError {
  @ id - 0
  Failed(
    @ id - 1
    message: string,
  ),
  @ id - 1
  PermissionDenied(
    @ id - 1
    message: string,
  ),
}
