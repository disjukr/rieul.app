{
  "name": "@rieul/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "desktop:icons": "tsx src/tools/generate-desktop-icons.ts",
    "build": "vite build",
    "check": "tsc -b && tsc -p tsconfig.tools.json",
    "test": "node --conditions=browser --experimental-test-module-mocks --import tsx --test tests/*.test.ts",
    "check:daemon": "tsx src/tools/check-daemon.ts",
    "preview": "vite preview --host 0.0.0.0",
    "desktop:build:windows": "node ../pairing/scripts/package.mjs --replace",
    "desktop:dev:windows": "node ../pairing/scripts/dev.mjs --config ../tmp/dev/rieul.yaml --show",
    "desktop:build:macos": "node ../pairing/scripts/package.mjs --replace",
    "desktop:dev:macos": "node ../pairing/scripts/dev.mjs --config ../tmp/dev/rieul.yaml --show"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.20",
    "@unocss/reset": "66.7.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "bunja": "4.0.0-alpha.2",
    "marked": "18.0.5",
    "monaco-editor": "0.55.1",
    "pdfjs-dist": "5.7.284",
    "solid-js": "2.0.0-rc.20",
    "zyzz": "0.0.44"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@solidjs/vite-plugin": "3.0.0-next.54",
    "rollup-plugin-visualizer": "6.0.11",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
